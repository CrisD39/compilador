#!/bin/bash
# Corre los testers de Etapas 1-3 antes de cada commit que toque Código/.
# Los commits que sólo tocan documentación no corren nada.
# Se activa una vez por clon con: git config core.hooksPath .githooks
# Para saltearlo en un commit puntual: git commit --no-verify
raiz="$(git rev-parse --show-toplevel)"

# quotepath=false: si no, git escribe "C\303\263digo/..." y el grep no matchea.
if ! git -c core.quotepath=false diff --cached --name-only | grep -q '^Código/'; then
    exit 0
fi

if ! "$raiz/Código/test.sh"; then
    echo "pre-commit: hay testers en rojo; commit cancelado." >&2
    exit 1
fi

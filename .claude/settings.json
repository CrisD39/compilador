{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./build.sh)",
      "Bash(Código/build.sh)",
      "Bash(javac:*)",
      "Bash(java:*)",
      "Bash(jar:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  }
}
